{
  "name": "market-management",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cf:whoami": "wrangler whoami",
    "cf:types": "wrangler types",
    "cf:dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy:preview": "npm run build && wrangler versions upload",
    "db:migrate": "node --env-file-if-exists=.dev.vars scripts/migrate.ts",
    "db:migrate:dry": "node --env-file-if-exists=.dev.vars scripts/migrate.ts --dry-run",
    "db:status": "node --env-file-if-exists=.dev.vars scripts/migrate.ts --status",
    "test": "npm run test:migrate && npm run test:worker && npm run test:client-auth && npm run test:verify-prod",
    "test:migrate": "node --test scripts/migrate-lib.test.ts",
    "test:worker": "node --test scripts/worker-auth.test.ts scripts/worker-routing.test.ts",
    "test:client-auth": "node --test scripts/api-fetch.test.ts scripts/auth-session.test.ts scripts/auth-token.test.ts scripts/auth-client-credentials.test.ts",
    "test:verify-prod": "node --test scripts/verify-production-lib.test.ts",
    "verify:production": "node scripts/verify-production.ts"
  },
  "dependencies": {
    "@neondatabase/neon-js": "0.7.0-beta",
    "@neondatabase/serverless": "1.1.0",
    "@progress/kendo-licensing": "1.11.3",
    "@progress/kendo-react-animation": "16.1.0",
    "@progress/kendo-react-buttons": "16.1.0",
    "@progress/kendo-react-common": "16.1.0",
    "@progress/kendo-react-indicators": "16.1.0",
    "@progress/kendo-react-inputs": "16.1.0",
    "@progress/kendo-react-intl": "16.1.0",
    "@progress/kendo-react-layout": "16.1.0",
    "@progress/kendo-react-popup": "16.1.0",
    "@progress/kendo-react-progressbars": "16.1.0",
    "@progress/kendo-svg-icons": "5.4.0",
    "@progress/kendo-theme-meridian": "14.5.0",
    "jose": "6.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@progress/kendo-cli": "^1.22.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "3.9.9",
    "sass": "^1.105.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "wrangler": "4.146.0"
  }
}
