{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Worker name. Must match the Worker name shown in the Cloudflare dashboard.
  // A fork deploying its own instance changes this value (see docs/DEPLOYMENT.md).
  "name": "market-management",

  // Pins the Workers runtime behaviour to the date this config was authored.
  "compatibility_date": "2026-10-06",

  "assets": {
    // Vite build output. Regenerated by `npm run build`; git-ignored.
    "directory": "./dist",

    // Serve index.html with HTTP 200 for any unmatched navigation request so that
    // client-side deep links (e.g. /markets/123) work. Workers does NOT infer this.
    "not_found_handling": "single-page-application",
  },

  // Worker logs in the Cloudflare dashboard.
  "observability": {
    "enabled": true,
  },
}
