{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Worker name. Must match the Worker name shown in the Cloudflare dashboard.
  // A fork deploying its own instance changes this value (see docs/DEPLOYMENT.md).
  "name": "market-management",

  // Worker entry point. Requests matching `assets.run_worker_first` below are handled
  // here; everything else is served from `dist/` by the Asset Worker.
  "main": "src/worker/index.ts",

  // Pins the Workers runtime behaviour to the date this config was authored.
  "compatibility_date": "2026-10-06",

  "assets": {
    // Vite build output. Regenerated by `npm run build`; git-ignored.
    "directory": "./dist",

    // Lets Worker code call `env.ASSETS.fetch(request)` to serve a static asset itself.
    "binding": "ASSETS",

    // Serve index.html with HTTP 200 for any unmatched navigation request so that
    // client-side deep links (e.g. /markets/123) work. Workers does NOT infer this.
    "not_found_handling": "single-page-application",

    // Only `/api/*` reaches the Worker script. Every other path keeps the existing
    // asset-first behaviour, so SPA deep links are unaffected.
    "run_worker_first": ["/api/*"],
  },

  // Worker logs in the Cloudflare dashboard.
  "observability": {
    "enabled": true,
  },
}
