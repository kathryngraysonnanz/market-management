# Cloudflare Workers Static Assets header rules.
# Syntax: a URL pattern on its own line, then indented "Name: value" lines.
# A request matching several patterns inherits the headers from all of them.
# Docs: https://developers.cloudflare.com/workers/static-assets/headers/
#
# NOTE: these rules apply to STATIC ASSET responses only. If a Worker script is
# added later (wrangler.jsonc `main`), responses it generates must set their own
# headers in code.

# Vite emits content-hashed filenames into /assets, so a new build always
# produces a new URL. Cache them forever. Without this rule Cloudflare's default
# is `public, max-age=0, must-revalidate` for every file.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The SPA shell references the current hashed bundle names and must never be
# served stale after a deploy.
/index.html
  Cache-Control: no-cache

# Baseline security headers for every response.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
