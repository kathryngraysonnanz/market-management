# ---------------------------------------------------------------------------
# Vite BUILD-TIME variables.
#
# WARNING: every VITE_* value is string-substituted into the JavaScript bundle
# at `npm run build` time and is therefore PUBLIC. Anyone can read it with
# browser devtools. NEVER put an API key, token, password or any other secret
# in this file or in any VITE_* variable.
#
# For genuinely secret values see .dev.vars.example and docs/DEPLOYMENT.md.
# ---------------------------------------------------------------------------
#
# Local use: copy this file to `.env.local` and edit. `.env.local` is
# git-ignored. Production use: set the same names as `env:` entries in
# .github/workflows/deploy.yml, or as Build variables in the Cloudflare
# dashboard if deploying via Workers Builds.

# Product name shown in the application header.
# Default when unset: "Market Management" (see src/lib/env.ts).
VITE_APP_NAME=Market Management

# Base URL of this environment's Neon Auth (Managed Better Auth) instance.
# Example: https://ep-example-123456.neonauth.REGION.aws.neon.tech/DATABASE/auth
#
# PUBLIC and safe here: the browser calls this host directly, and the JWKS signing keys published
# under it are public by design. Neon Auth requires no publishable key and no client key, so this
# feature introduces no client-side secret at all.
#
# Each Neon BRANCH provisions its own Auth instance with its own URL and its own signing keys.
# Locally this must point at the `development` branch, never `production`. Get it with:
#     neon neon-auth status --branch development
#
# The Worker needs the same value at runtime under the name NEON_AUTH_BASE_URL — see
# .dev.vars.example. The two names exist because Vite inlines VITE_* at build time while the Worker
# reads its environment at runtime; one name cannot serve both contexts. They must match.
VITE_NEON_AUTH_URL="https://ep-example-123456.neonauth.REGION.aws.neon.tech/DATABASE/auth"
